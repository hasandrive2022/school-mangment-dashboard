# Supabase Postgres connection string from the project Connect panel
# Use the direct connection for migrations and long-lived backend processes.
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[project-id].supabase.co:5432/postgres?sslmode=require"
#JWT_SECRET=

# Optional: session lifetime in seconds (default 28800 = 8h). Max 30 days.
# SESSION_MAX_AGE_SECONDS=28800

# SESSION_COOKIE_NAME="auth"

# Production uses the __Host-admin_session cookie (HTTPS only). Use https:// locally
# if you run `next start` and need to sign in.

# Used only by `npm run seed:admin` (one-time bootstrap)
# ADMIN_EMAIL="admin@example.com"
# ADMIN_PASSWORD="123456789012"
